# 将占位值替换为本机秘密，通过终端环境配置 Java 与 Python。
# Compose 读取本机 .env。直接运行 Java 和 Python 时还需把变量导入当前环境。
OPSPILOT_DB_URL=jdbc:mysql://127.0.0.1:13316/opspilot
OPSPILOT_DB_USER=opspilot
OPSPILOT_DB_PASSWORD=
OPSPILOT_DB_PORT=13316
OPSPILOT_JWT_KEY=
OPSPILOT_AGENT_TOKEN=
OPSPILOT_BOOTSTRAP_TENANT=lab
OPSPILOT_BOOTSTRAP_USER=admin
OPSPILOT_BOOTSTRAP_PASSWORD=
OPSPILOT_AGENT_DB=.local/agent.sqlite3
OPSPILOT_PROVIDER=DETERMINISTIC_TEST
OPSPILOT_ALERT_REDIS_ENABLED=false
OPSPILOT_REDIS_PORT=16379
